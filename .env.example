# Pollinations BYOP Configuration
# BYOP is only used when HOSTING=true AND LLM_API_KEY is empty.
# Set LLM_API_KEY to let the server pay for AI calls (BYOP then disabled).
POLLINATIONS_APP_KEY=pk_your_app_key_here

# LLM Settings (optional overrides)
LLM_BASE_URL=https://gen.pollinations.ai/v1
LLM_MODEL=openai
LLM_API_KEY=

# Hosting Mode
HOSTING=false

# Media processing
# always = re-encode every upload, auto = re-encode only if not web-compatible, never = always passthrough
MEDIA_COMPRESS_MODE=always
